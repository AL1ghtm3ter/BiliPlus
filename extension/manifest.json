{
  "manifest_version": 3,
  "name": "小电视助手 · BiliPlus",
  "description": "B站倍速、左右分屏、推荐历史、封面查看、评论属地与界面净化；附带可选的本机模型字幕分析。独立源码版。",
  "version": "3.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["https://api.bilibili.com/*", "https://*.hdslb.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "小电视助手 · BiliPlus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*"
      ],
      "js": ["subtitles.js", "capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*"
      ],
      "js": [
        "common/config.js",
        "common/ui.js",
        "subtitles.js",
        "features/runtime.js",
        "features/player.js",
        "features/filter.js",
        "features/layout.js",
        "features/home.js",
        "features/index.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css", "common/brand.svg"],
      "matches": ["https://www.bilibili.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
